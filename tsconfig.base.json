{
	"compilerOptions": {
		"target": "esnext",
		"lib": ["ESNext"],
		"jsx": "preserve",
		"moduleDetection": "force",
		"module": "esnext",
		"moduleResolution": "bundler",
		"types": [
			"bun-types" // add Bun global
		],
		"allowImportingTsExtensions": true,
		"allowJs": true,
		"noEmit": true,
		"downlevelIteration": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}

{
	"name": "@pulsarjs/plugin-vite",
	"type": "module",
	"version": "0.0.1",
	"description": "A lightweight SSR JSX meta-framework built on Elysia",
	"author": "Ernest Nkansah-Badu <ernestjbadu@outlook.com>",
	"license": "MIT",
	"homepage": "https://pulsarjs.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ernxst/pulsar.git",
		"directory": "."
	},
	"bugs": {
		"url": "https://github.com/Ernxst/pulsar/issues"
	},
	"keywords": [
		"typescript"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts",
				"./dist/index.d.cts"
			]
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=v18.0.0"
	},
	"scripts": {
		"------------------------------------------------------------------------------": "",
		"build": "tsup",
		"postbuild": "publint",
		"-------------------------------------------------------------------------------": "",
		"typecheck": "tsc --noEmit",
		"--------------------------------------------------------------------------------": "",
		"test": "bun test"
	},
	"peerDependencies": {
		"@phenomnomnominal/tsquery": "6.1.3",
		"typescript": "^5.1.0",
		"vite": "^4.4.9"
	},
	"peerDependenciesMeta": {
		"@phenomnomnominal/tsquery": {
			"optional": false
		},
		"typescript": {
			"optional": true
		},
		"vite": {
			"optional": false
		}
	},
	"dependencies": {
		"@phenomnomnominal/tsquery": "6.1.3",
		"vite": "^4.4.9"
	},
	"devDependencies": {
		"minimatch": "9.0.3",
		"slugify": "1.6.6",
		"tiny-glob": "0.2.9",
		"ts-morph": "20.0.0"
	}
}

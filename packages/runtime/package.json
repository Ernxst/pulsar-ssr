{
	"name": "@pulsarjs/runtime",
	"type": "module",
	"version": "0.0.1",
	"description": "A lightweight SSR JSX meta-framework built on Hono",
	"author": "Ernest Nkansah-Badu <ernestjbadu@loader.com>",
	"license": "MIT",
	"homepage": "https://pulsarjs.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ernxst/pulsar.git",
		"directory": "."
	},
	"bugs": {
		"url": "https://github.com/Ernxst/pulsar/issues"
	},
	"keywords": [
		"typescript"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./adapters": {
			"import": {
				"types": "./dist/adapters/index.d.ts",
				"default": "./dist/adapters/index.js"
			},
			"require": {
				"types": "./dist/adapters/index.d.cts",
				"default": "./dist/adapters/index.cjs"
			}
		}
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts",
				"./dist/index.d.cts"
			],
			"adapters": [
				"./dist/adapters/index.d.ts",
				"./dist/adapters/index.d.cts"
			]
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=v18.0.0"
	},
	"scripts": {
		"------------------------------------------------------------------------------": "",
		"build": "tsup",
		"postbuild": "publint",
		"-------------------------------------------------------------------------------": "",
		"typecheck": "tsc --noEmit",
		"--------------------------------------------------------------------------------": "",
		"test": "bun test"
	},
	"peerDependencies": {
		"pulsar": "^0.0.1",
		"typescript": "^5.1.0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"dependencies": {
		"pulsar": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "18.18.8",
		"@types/set-cookie-parser": "2.4.6",
		"hono": "3.10.0",
		"set-cookie-parser": "2.6.0"
	}
}

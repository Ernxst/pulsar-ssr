{
	"name": "@pulsarjs/parser",
	"type": "module",
	"version": "0.0.1",
	"description": "A lightweight SSR JSX meta-framework built on Hono",
	"author": "Ernest Nkansah-Badu <ernestjbadu@outlook.com>",
	"license": "MIT",
	"homepage": "https://pulsarjs.dev",
	"repository": {
		"type": "git",
		"url": "https://github.com/Ernxst/pulsar.git",
		"directory": "packages/parser"
	},
	"bugs": {
		"url": "https://github.com/Ernxst/pulsar/issues"
	},
	"keywords": [
		"typescript"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		}
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		"*": {
			".": [
				"./dist/index.d.ts"
			]
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"engines": {
		"node": ">=v18.0.0"
	},
	"scripts": {
		"------------------------------------------------------------------------------": "",
		"build": "tsup",
		"postbuild": "publint",
		"-------------------------------------------------------------------------------": "",
		"typecheck": "tsc --noEmit",
		"--------------------------------------------------------------------------------": "",
		"test": "bun test"
	},
	"devDependencies": {
		"@babel/generator": "7.23.4",
		"@babel/types": "7.23.3",
		"@types/babel__generator": "7.6.7",
		"@types/esquery": "1.5.3",
		"acorn": "8.11.2",
		"acorn-typescript": "1.4.11",
		"esquery": "1.5.0",
		"estree-util-to-js": "2.0.0",
		"estree-util-visit": "2.0.0"
	}
}

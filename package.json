{
	"name": "root",
	"version": "0.0.0",
	"private": true,
	"packageManager": "bun@1.0.6",
	"engines": {
		"node": ">=18.12.1",
		"bun": "1.0.6"
	},
	"workspaces": [
		"examples/*",
		"packages/*"
	],
	"scripts": {
		"------------------------------------------------------------------------------": "",
		"build": "turbo run build",
		"-------------------------------------------------------------------------------": "",
		"dts": "turbo run dts --continue",
		"typecheck": "turbo run typecheck",
		"--------------------------------------------------------------------------------": "",
		"lint": "eslint --cache .",
		"lint:fix": "eslint . --fix --cache",
		"format": "prettier --cache --write \"**/*.@(svelte|js|ts|tsx|cjs|mjs|json|md|toml)\"",
		"---------------------------------------------------------------------------------": "",
		"test": "turbo run test",
		"----------------------------------------------------------------------------------": "",
		"prepare": "husky install",
		"-----------------------------------------------------------------------------------": "",
		"prepublishOnly": "bun run build",
		"release": "bun run build && changeset publish",
		"version": "changeset version && bun install --no-frozen-lockfile && bun run format"
	},
	"dependencies": {
		"publint": "0.2.2",
		"tsup": "7.2.0",
		"typescript": "5.2.2"
	},
	"devDependencies": {
		"@antfu/eslint-config": "0.43.1",
		"@changesets/changelog-github": "0.4.8",
		"@changesets/cli": "2.26.2",
		"@commitlint/cli": "17.8.0",
		"@commitlint/config-conventional": "17.8.0",
		"bun-types": "1.0.6",
		"eslint": "8.51.0",
		"eslint-config-turbo": "1.10.15",
		"eslint-plugin-import": "2.28.1",
		"husky": "8.0.3",
		"nano-staged": "0.8.0",
		"prettier": "3.0.3",
		"prettier-plugin-svelte": "3.0.3",
		"turbo": "1.10.15"
	},
	"nano-staged": {
		"*": [
			"eslint --fix",
			"prettier --cache --write **/*.@(svelte|js|ts|tsx|cjs|mjs|json|md|toml)"
		]
	}
}

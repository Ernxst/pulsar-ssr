{
	"extends": ["../../tsconfig.base.json"],
	"compilerOptions": {
		"baseUrl": ".",
		"outDir": "./dist",
		"jsx": "react",
		"jsxFactory": "Html.createElement",
		"jsxFragmentFactory": "Html.Fragment",
		"plugins": [{ "name": "@kitajs/ts-html-plugin" }]
	},
	"include": ["src"],
	"exclude": ["dist", "node_modules", "**/*.spec.ts"]
}
